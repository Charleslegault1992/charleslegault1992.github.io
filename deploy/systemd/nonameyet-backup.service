[Unit]
Description=Nonameyet verified SQLite backup
After=nonameyet.service

[Service]
Type=oneshot
User=nonameyet
Group=nonameyet
WorkingDirectory=/opt/nonameyet
EnvironmentFile=/etc/nonameyet/nonameyet.env
StateDirectory=nonameyet
StateDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/nonameyet/backups
ExecStart=/usr/bin/node server/backupDatabase.js
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/nonameyet
